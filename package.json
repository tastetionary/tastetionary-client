{
  "name": "tastetionary",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "pnpm": ">=8",
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint-fix": "lint-staged",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "pnpm format && pnpm lint:fix",
    "knip": "pnpm --filter web knip",
    "knip:fix": "pnpm --filter web knip:fix",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "lint-staged": "^13.2.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": [
      "oxfmt",
      "oxlint --fix"
    ]
  }
}
